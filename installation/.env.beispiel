# Wird vom Installationsskript angelegt. Von Hand nur, wenn du ohne Skript
# installierst: als .env speichern und alle Werte füllen.
# Zufallswerte z.B. mit: openssl rand -hex 32

# Adresse, unter der die App erreichbar ist (ohne https://).
DOMAIN=imkerei.example.de

# Passwort der Datenbank. Nur Buchstaben und Ziffern.
DB_PASSWORT=

# Schützt Anmeldung und gespeicherte Mail-Passwörter. Nie ändern, sonst sind
# alle abgemeldet und Mail-Passwörter müssen neu eingegeben werden.
ANMELDUNG_GEHEIMNIS=

# Fragt der Einrichtungsassistent beim ersten Start ab.
EINRICHTUNG_CODE=

# Welche Version läuft. "1" = immer die neueste 1.x.
IMKEREI_VERSION=1
