# Kopieren nach .env und Werte anpassen.

DATABASE_URL="postgresql://benutzer:passwort@localhost:5432/imkereiverwaltung?schema=public"

UPLOAD_DIR="./uploads"

# Eigene Anmeldung (siehe web/src/lib/anmeldung.ts) statt HTTP Basic Auth -
# ANMELDUNG_GEHEIMNIS mit z.B. `openssl rand -hex 32` erzeugen, nicht selbst
# ausdenken.
ANMELDUNG_BENUTZERNAME="Frank"
ANMELDUNG_PASSWORT="bitte-aendern"
ANMELDUNG_GEHEIMNIS=""

# --- Öffentliche Demo (nur für eine eigene Demo-Instanz mit eigener Datenbank,
# nie bei echten Daten). Siehe web/src/lib/demo.ts.
# DEMO_MODUS="1"
# DEMO_PLAETZE="10"
# Impressum und Datenschutz der Demo. Zeilen der Anschrift mit | trennen.
# IMPRESSUM_NAME="Vorname Nachname"
# IMPRESSUM_ANSCHRIFT="Straße 1|12345 Ort"
# IMPRESSUM_EMAIL="demo@example.org"
# IMPRESSUM_TELEFON=""
